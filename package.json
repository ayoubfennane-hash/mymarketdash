{
  "name": "mymarketdash",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outdir=dist-server",
    "test": "vitest run",
    "start": "NODE_ENV=production node dist-server/index.js",
    "db:migrate": "tsx server/migrate.ts"
  },
  "dependencies": {
    "cookie-parser": "1.4.7",
    "express": "4.21.2",
    "fflate": "0.8.2",
    "jose": "5.10.0",
    "lucide-react": "0.468.0",
    "mysql2": "3.15.3",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "recharts": "3.1.2",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.9",
    "@types/express": "4.17.23",
    "@types/node": "22.18.0",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.9",
    "@types/supertest": "6.0.3",
    "@vitejs/plugin-react": "5.0.2",
    "esbuild": "0.25.9",
    "fake-indexeddb": "6.2.4",
    "jsdom": "26.1.0",
    "supertest": "7.1.4",
    "tsx": "4.20.6",
    "typescript": "5.9.2",
    "vite": "7.1.3",
    "vitest": "3.2.4"
  }
}
